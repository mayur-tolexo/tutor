# Copy to .env. Every variable is optional; unset ones fall back to a
# development mode the server warns about at startup.

# Listen address.
ADDR=:8080

# Postgres. Unset -> in-memory store (data lost on restart).
DATABASE_URL=postgres://tutor:tutor@localhost:5432/tutor?sslmode=disable

# Sandbox runner. Unset NEEV_API_KEY -> local python3 with NO isolation (dev only).
NEEV_API_KEY=
NEEV_ORG_ID=
NEEV_PROJECT_ID=
NEEV_API_BASE=https://api.ai.neevcloud.com/agent
NEEV_REGION=
# Leave empty to stay eligible for the platform's warm pool.
NEEV_TEMPLATE_ID=
SANDBOX_PYTHON=python3
SANDBOX_PREWARM=2
SANDBOX_MAX_INFLIGHT=50

# Tutor model: any OpenAI-compatible chat completions endpoint.
# Unset LLM_BASE_URL -> canned and generic hints only.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Global cap on model calls per day; 0 = unlimited.
MODEL_DAILY_BUDGET=0

# Google sign-in. Unset -> sign-in hidden; students stay anonymous per device.
GOOGLE_CLIENT_ID=

# At least 32 random bytes; signs the session cookie.
SESSION_KEY=
# Set to any value to allow cookies over plain HTTP (local development only).
INSECURE_COOKIES=

# Load content from a directory instead of the copy embedded in the binary.
CONTENT_DIR=
